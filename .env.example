# Path to your own Stockfish binary (never bundled, see docs/adr/0002)
STOCKFISH_PATH=/usr/local/bin/stockfish
# Optional: enables the Anthropic LlmProvider. Leave empty to use template fallback.
ANTHROPIC_API_KEY=
# Local SQLite file
DATABASE_PATH=./data/chessmirror.db
# Descriptive User-Agent for chess.com requests, include a contact
CHESSCOM_USER_AGENT=chessmirror/0.0 (contact: you@example.com)
# Coach LLM provider name (default: anthropic). See src/core/coach/registry.ts
CHESSMIRROR_LLM_PROVIDER=anthropic
# Anthropic model id used by the coach (default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Set to 1 to serve canned demo data instead of the real pipeline
CHESSMIRROR_MOCK=
# Stockfish search depth per position (default 12, 1 to 30)
CHESSMIRROR_DEPTH=12
# Most recent games analyzed per job (default 50, 1 to 200)
CHESSMIRROR_MAX_GAMES=50
# Lichess puzzle index built by npm run setup:puzzles (see docs/adr/0004)
PUZZLES_DATABASE_PATH=./data/puzzles.db
