    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
